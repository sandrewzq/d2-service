{
  "name": "@d2-tools/app",
  "version": "0.0.20",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "import": "./dist/assistant.js"
    },
    "./armor": {
      "types": "./dist/armor.d.ts",
      "import": "./dist/armor.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./home": {
      "types": "./dist/home.d.ts",
      "import": "./dist/home.js"
    },
    "./guides": {
      "types": "./dist/guides.d.ts",
      "import": "./dist/guides.js"
    },
    "./items": {
      "types": "./dist/items.d.ts",
      "import": "./dist/items.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./loadouts": {
      "types": "./dist/loadouts.d.ts",
      "import": "./dist/loadouts.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    },
    "./vendors": {
      "types": "./dist/vendors.d.ts",
      "import": "./dist/vendors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --root ../.. --run"
  },
  "dependencies": {
    "@d2-tools/core": "workspace:*",
    "@d2-tools/services": "workspace:*"
  },
  "sideEffects": false
}
