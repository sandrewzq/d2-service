{
  "name": "d2-tools",
  "version": "0.0.25",
  "license": "MIT",
  "private": true,
  "description": "A Windows-first Chinese Destiny 2 desktop companion for everyday players.",
  "author": "sandrew",
  "homepage": "https://github.com/sandrewzq/d2-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrewzq/d2-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sandrewzq/d2-tools/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @d2-tools/desktop dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:electron": "pnpm --filter @d2-tools/desktop dev:electron",
    "dev:web": "pnpm --filter @d2-tools/web dev",
    "visual:ai": "node scripts/visual-ai-check.mjs",
    "visual:all": "node scripts/visual-all-check.mjs",
    "visual:shell-contract": "node scripts/visual-all-check.mjs --shell-contract-only",
    "ci:local": "node scripts/run-ci-local.mjs",
    "build": "pnpm -r build",
    "check": "pnpm docs:check && git diff --check",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "check:exports": "node scripts/check-workspace-exports.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "docs:check": "node scripts/check-doc-policy.mjs && pnpm encoding:check",
    "test:behavior": "node scripts/run-test-set.mjs behavior",
    "test:architecture": "node scripts/run-test-set.mjs architecture",
    "ui:contract:check": "node scripts/check-ui-contract.mjs",
    "test:quality": "node scripts/check-test-quality.mjs && pnpm check:exports && pnpm ui:contract:check && pnpm licenses:check",
    "test:ci": "pnpm docs:check && pnpm build && pnpm test:behavior && pnpm test:quality && pnpm test:architecture",
    "test:all": "vitest --run",
    "test:fast": "pnpm test:behavior",
    "test:docs": "vitest --run scripts/check-doc-policy.test.mjs scripts/check-encoding.test.mjs scripts/dev-tools.test.mjs",
    "test:ui": "node scripts/run-test-set.mjs ui",
    "test:desktop": "vitest --run packages/desktop/test",
    "test:desktop:account": "node scripts/run-test-set.mjs desktop-account",
    "test:desktop:ai": "node scripts/run-test-set.mjs desktop-ai",
    "test:desktop:loadouts": "node scripts/run-test-set.mjs desktop-loadouts",
    "test:desktop:vault": "node scripts/run-test-set.mjs desktop-vault",
    "test:desktop-wiring": "node scripts/run-test-set.mjs desktop-wiring",
    "test:release": "node scripts/run-test-set.mjs release",
    "test": "pnpm test:ci",
    "typecheck:ui": "pnpm --filter @d2-tools/ui typecheck && pnpm --filter @d2-tools/web typecheck",
    "typecheck:ci": "pnpm -r typecheck",
    "typecheck:desktop-fast": "pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/services build && pnpm --filter @d2-tools/app build && pnpm --filter @d2-tools/desktop typecheck",
    "typecheck:desktop": "pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/http build && pnpm --filter @d2-tools/services build && pnpm --filter @d2-tools/app build && pnpm --filter @d2-tools/desktop typecheck",
    "typecheck": "pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/http build && pnpm --filter @d2-tools/services build && pnpm --filter @d2-tools/app build && pnpm -r typecheck",
    "verify:release": "pnpm check && pnpm test:docs && pnpm test:release",
    "package:win": "pnpm --filter @d2-tools/desktop package:win",
    "package:local": "pnpm test && pnpm typecheck && pnpm package:win",
    "release:preview": "node scripts/preview-release-notes.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
